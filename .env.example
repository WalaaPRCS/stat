APP_ORIGIN=https://your-statistics-domain.example
# Generate a private random value, e.g. openssl rand -hex 32
SETUP_KEY=

# EMS aggregate integration (set the same strong token in both applications)
EMS_INTEGRATION_URL=https://your-ems-domain.example/api/integrations/statistics/ambulance
EMS_INTEGRATION_TOKEN=
# Optional first import date; omit to start from the current UTC day
# EMS_SYNC_FROM_DATE=2026-10-14
EMS_SYNC_INTERVAL_MS=300000
